# ===== NIFTY-PRO (.env) — இந்த பைலை .env ஆக நகலெடுத்து நிரப்பவும்; git-ல் சேர்க்க வேண்டாம் =====
ENV=production
# தனி DB — production ./data/analyzer.db-ஐ தொடாது
SQLITE_DB_PATH=./data/analyzer_pro.db
PORT=8001

# Angel One SmartAPI (டேட்டா + ஆர்டர்)
ANGEL_API_KEY=
ANGEL_CLIENT_ID=
ANGEL_PASSWORD=
ANGEL_TOTP_SECRET=

# Zerodha Kite Connect (MCX gold/silver/crude) — விருப்பம்; pip install kiteconnect
KITE_API_KEY=
KITE_API_SECRET=
KITE_ACCESS_TOKEN=

# NewsAPI (செய்தி சென்டிமென்ட்) — விருப்பம்
NEWSAPI_KEY=

# ---- ஆர்டர் பாதுகாப்பு (இயல்பு = PAPER; ஆர்டர் எதுவும் broker-க்கு போகாது) ----
TRADING_MODE=paper
LIVE_TRADING_ENABLED=false
ORDER_PIN=
MAX_LOTS_PER_ORDER=1
MAX_ORDERS_PER_DAY=10
ALLOW_NAKED_SELL=false
MIN_FREE_CASH_PER_SELL_LOT=150000
ORDER_PRODUCT_TYPE=INTRADAY

# ---- SELL சிக்னல் அளவுருக்கள் ----
IV_RANK_MIN_SAMPLES=30
SELL_SL_MULTIPLE=1.4
SELL_TARGET_FRACTION=0.5
CRUDE_NIFTY_BETA=-0.4
