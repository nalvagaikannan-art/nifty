# Environment: "development" (uvicorn auto-reload on) or "production" (reload off)
ENV=production

# AI Provider API Keys (at least one must be set)
GEMINI_API_KEY=your_gemini_key
OPENAI_API_KEY=your_openai_key
DEEPSEEK_API_KEY=your_deepseek_key

# Preferred AI provider (gemini, openai, deepseek)
AI_PROVIDER=gemini

# Database
SQLITE_DB_PATH=./data/analyzer.db

# Cache TTL (seconds)
CACHE_TTL=60

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log

# NSE API Headers (to mimic browser)
NSE_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/91.0.4472.124 Safari/537.36
NSE_ACCEPT=application/json, text/plain, */*

# Comma-separated list of frontend origins allowed to call this API
CORS_ALLOWED_ORIGINS=http://localhost:8000

# Max requests per client IP per minute on /api/* routes
API_RATE_LIMIT_PER_MINUTE=60

# Trading capital (₹) used by the Risk Engine for position sizing in
# /api/strategy/recommend. Set this to your actual trading capital.
# Default: 200000 (₹2 Lakh)
DEFAULT_CAPITAL=200000

# Background history collector — keeps saving market snapshots + AI signals
# every N minutes so the Accuracy page has data even with no browser open.
# Set to 0 to disable.
HISTORY_COLLECTOR_INTERVAL_MINUTES=5
HISTORY_COLLECTOR_SYMBOLS=NIFTY,BANKNIFTY,FINNIFTY

# ── Angel One SmartAPI ──────────────────────────────────────────────────────
# Angel One account-ல் SmartAPI enable செய்து credentials பெறவும்:
# https://smartapi.angelbroking.com/

# SmartAPI App-இல் உருவாக்கிய API Key
ANGEL_API_KEY=your_angel_api_key

# Angel One Client ID (login username)
ANGEL_CLIENT_ID=A12345

# Angel One login password
ANGEL_PASSWORD=your_angel_password

# TOTP Secret Key (Base32)
# Angel One app → My Profile → Enable TOTP → Secret Key copy செய்யவும்
# Google Authenticator-ல் add செய்த அதே secret key இங்கே enter செய்யவும்
ANGEL_TOTP_SECRET=JBSWY3DPEHPK3PXP

# ── Zerodha Kite Connect (optional second broker — spec §5 provider
#    abstraction) ─────────────────────────────────────────────────────────
# Fallback order: Angel One → Zerodha → NSE scrape. Leave all three below
# unset to skip Zerodha entirely — no behavior change if you're only using
# Angel One / NSE. Get an app + api_key/api_secret at https://kite.trade/
# (needs an active Zerodha trading account + Kite Connect subscription).
#
# KITE_ACCESS_TOKEN is NOT a fixed secret like the others — it expires daily
# (~06:00 IST) and must be regenerated via a one-time browser login each
# trading day. See app/services/zerodha.py's module docstring for the exact
# login_url()/generate_session() steps; typically automated with a small
# scheduled script that updates this value (or wherever you're loading env
# vars from) before market open.
KITE_API_KEY=your_kite_api_key
KITE_API_SECRET=your_kite_api_secret
KITE_ACCESS_TOKEN=todays_generated_access_token
